  "specs": {
    "handshape": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 30,
        "track": [
          "hands",
          "pose"
        ],
        "guide": "Upper body and dominant hand in frame, plain background"
      },
      "segment": {
        "by": "moves",
        "min_duration_s": 0.2
      },
      "reference": "learner-media/asl-fingerspelling.mp4",
      "metrics": {
        "index_curl": "mean(angle(right_hand.index_mcp, right_hand.index_pip, right_hand.index_tip)) per move",
        "thumb_gap": "mean(distance(right_hand.thumb_tip, right_hand.index_mcp)) per move",
        "shape": "pose_similarity(reference, joints: [arms], align: dtw)",
        "hand_drift": "std(right_hand.wrist.y)"
      },
      "mistakes": [
        {
          "id": "bouncing",
          "when": "hand_drift > 0.1",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(right_hand.wrist.y)",
          "fix_drill": "spell-drill"
        }
      ],
      "requires_visible": [
        "right_hand.wrist",
        "right_hand.index_tip",
        "right_hand.thumb_tip"
      ]
    },
    "sign-motion": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 30,
        "track": [
          "hands",
          "pose",
          "face"
        ],
        "guide": "Head to waist in frame"
      },
      "segment": {
        "by": "moves",
        "min_duration_s": 0.3
      },
      "reference": "learner-media/asl-everyday-signs.mp4",
      "metrics": {
        "similarity": "pose_similarity(reference, joints: [arms, head], align: dtw)",
        "start_height": "first(right_hand.wrist.y) per move",
        "path_len": "sum(speed(right_hand.wrist)) per move"
      },
      "mistakes": [
        {
          "id": "off-shape",
          "when": "similarity < 0.6",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "ghost",
          "fix_drill": "sign-drill"
        }
      ]
    },
    "question-face": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 30,
        "track": [
          "face",
          "hands"
        ],
        "guide": "Face and hands in frame, good light on your face"
      },
      "segment": {
        "by": "moves",
        "min_duration_s": 0.3
      },
      "metrics": {
        "brow_gap": "distance(face_forehead, face_nose_tip)",
        "brow_share": "share(brow_gap < baseline.brow_gap * 0.95)"
      },
      "mistakes": [
        {
          "id": "flat-face",
          "when": "brow_share < 0.3",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(distance(face_forehead, face_nose_tip))",
          "fix_drill": "face-drill"
        }
      ]
    },
    "sign-quiz": {
      "kind": "items",
      "items": [
        {
          "type": "match",
          "id": "a1",
          "prompt": "Match each description to its letter.",
          "pairs": [
            [
              "Fist, thumb beside",
              "A"
            ],
            [
              "Flat hand, thumb across palm",
              "B"
            ],
            [
              "Curved hand",
              "C"
            ]
          ],
          "difficulty": 1,
          "nodes": [
            "alphabet"
          ]
        },
        {
          "type": "choice",
          "id": "a2",
          "prompt": "Index and middle fingers up, together. Which letter?",
          "options": [
            "U",
            "V",
            "N"
          ],
          "answer": 0,
          "difficulty": 2,
          "nodes": [
            "alphabet"
          ]
        },
        {
          "type": "choice",
          "id": "a3",
          "prompt": "Flat hand from chin moving forward means...",
          "options": [
            "Thank you",
            "Hello",
            "Sorry"
          ],
          "answer": 0,
          "difficulty": 3,
          "nodes": [
            "vocabulary"
          ]
        },
        {
          "type": "choice",
          "id": "a4",
          "prompt": "Brows down with WHERE means...",
          "options": [
            "A WH-question",
            "A yes-no question"
          ],
          "answer": 0,
          "difficulty": 4,
          "nodes": [
            "facial-grammar"
          ]
        }
      ],
      "stop_after_wrong": 2,
      "pass": "accuracy >= 0.85"
    }
  },
