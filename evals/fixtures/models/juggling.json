  "specs": {
    "ball-arcs": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 60,
        "track": [
          "pose",
          "objects"
        ],
        "guide": "Facing the camera, hands and the space above your head in frame; 60 fps for fast balls"
      },
      "segment": {
        "by": "reps",
        "signal": "object.sports_ball.y"
      },
      "metrics": {
        "peak": "min(object.sports_ball.y) per rep",
        "throws": "count(peak)",
        "peak_spread": "std(peak)",
        "hand_drift": "range(mid_hip.x)",
        "clip_s": "duration()",
        "drops": "count(where(object.sports_ball.y, object.sports_ball.y > left_hip.y))"
      },
      "mistakes": [
        {
          "id": "uneven-peaks",
          "when": "peak_spread > 0.1",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(object.sports_ball.y)",
          "fix_drill": "one-ball"
        },
        {
          "id": "walking-forward",
          "when": "hand_drift > 0.2",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "skeleton",
          "fix_drill": "exchange-drill"
        }
      ],
      "requires_visible": [
        "object.sports_ball",
        "left_wrist",
        "right_wrist"
      ]
    },
