  "specs": {
    "hand-shape": {
      "kind": "metric",
      "capture": {
        "angle": "top",
        "fps": 30,
        "track": [
          "hands"
        ],
        "guide": "Phone above the keys, both hands in frame"
      },
      "segment": {
        "by": "whole"
      },
      "metrics": {
        "finger_curve": "mean(angle(right_hand.index_mcp, right_hand.index_pip, right_hand.index_tip))",
        "curved_share": "share(angle(right_hand.middle_mcp, right_hand.middle_pip, right_hand.middle_tip) < 165)",
        "wrist_drop": "mean(right_hand.wrist.y - right_hand.middle_mcp.y)"
      },
      "units": {
        "finger_curve": "deg"
      },
      "mistakes": [
        {
          "id": "flat-fingers",
          "when": "curved_share < 0.5",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(angle(right_hand.middle_mcp, right_hand.middle_pip, right_hand.middle_tip))",
          "fix_drill": "five-finger"
        }
      ],
      "requires_visible": [
        "right_hand.wrist",
        "right_hand.middle_mcp",
        "right_hand.middle_tip"
      ]
    },
