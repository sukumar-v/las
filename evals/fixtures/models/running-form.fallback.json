  "specs": {
    "stride-form": {
      "kind": "metric",
      "capture": {
        "angle": "side",
        "fps": 60,
        "guide": "Treadmill side view, whole body in frame, camera at hip height"
      },
      "segment": {
        "by": "reps",
        "signal": "left_ankle.y"
      },
      "phases": {
        "contact": "left_heel.y == max(left_heel.y)"
      },
      "metrics": {
        "trunk_lean": "mean(angle(mid_shoulder, mid_hip, vertical))",
        "overstride": "abs(left_heel.x - left_hip.x) at contact per rep",
        "shin_angle": "angle(left_knee, left_ankle, vertical) at contact per rep",
        "bounce": "range(mid_hip.y) per rep",
        "baseline_bounce": "baseline.bounce"
      },
      "units": {
        "trunk_lean": "deg",
        "shin_angle": "deg"
      },
      "mistakes": [
        {
          "id": "overstriding",
          "when": "mean(overstride) > 0.15",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(angle(left_knee, left_ankle, vertical))",
          "fix_drill": "landing-run"
        },
        {
          "id": "leaning-back",
          "when": "trunk_lean < 0",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(angle(mid_shoulder, mid_hip, vertical))",
          "fix_drill": "posture-run"
        }
      ],
      "requires_visible": [
        "left_hip",
        "left_knee",
        "left_ankle",
        "left_heel"
      ]
    },
    "cadence-video": {
      "kind": "metric",
      "capture": {
        "angle": "side",
        "fps": 60,
        "guide": "Treadmill side view; counts strides when no phone is paired"
      },
      "segment": {
        "by": "reps",
        "signal": "left_ankle.y"
      },
      "metrics": {
        "stride_s": "duration() per rep",
        "strides": "count(stride_s)",
        "clip_s": "sum(stride_s)",
        "cadence_spm": "strides * 2 * 60 / clip_s",
        "steadiness": "clamp(1 - std(stride_s) / mean(stride_s), 0, 1)"
      },
      "units": {
        "cadence_spm": "spm"
      },
      "mistakes": [
        {
          "id": "slow-cadence",
          "when": "cadence_spm < 155",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "beat_timeline",
          "fix_drill": "cadence-run"
        }
      ]
    },
    "cadence-phone": {
      "kind": "sensor",
      "detect": "cadence",
      "placement": "pocket",
      "duration_s": 120,
      "target": {
        "cadence_spm": 170
      },
      "pass": "cadence_spm >= 160 && cadence_spm <= 185 && steadiness >= 0.7"
    },
    "form-quiz": {
      "kind": "items",
      "items": [
        {
          "type": "choice",
          "id": "r1",
          "prompt": "Same pace, higher cadence: steps get...",
          "options": [
            "Shorter",
            "Longer"
          ],
          "answer": 0,
          "difficulty": 1,
          "nodes": [
            "cadence"
          ]
        },
        {
          "type": "choice",
          "id": "r2",
          "prompt": "Where should your foot land?",
          "options": [
            "Near under the hips",
            "Far in front"
          ],
          "answer": 0,
          "difficulty": 2,
          "nodes": [
            "landing"
          ]
        },
        {
          "type": "choice",
          "id": "r3",
          "prompt": "A forward lean starts at the...",
          "options": [
            "Ankles",
            "Waist",
            "Neck"
          ],
          "answer": 0,
          "difficulty": 3,
          "nodes": [
            "posture"
          ]
        }
      ],
      "stop_after_wrong": 2
    }
  },
  "mistakes": [
    {
      "id": "overstriding",
      "name": "Overstriding",
      "nodes": [
        "landing"
      ],
      "engine": "movement",
