        {
          "type": "sim",
          "text": "Drag your pace. Watch how much a listener keeps.",
          "sim": {
            "kind": "sim",
            "title": "Pace and recall",
            "params": {
              "wpm": {
                "label": "Words per minute",
                "min": 80,
                "max": 240,
                "default": 180
              }
            },
            "formulas": {
              "recall_pct": "clamp(100 - abs(wpm - 145) * 0.6, 0, 100)"
            },
            "figure": {
              "kind": "plot",
              "x": "wpm",
              "series": [
                "recall_pct"
              ]
            },
            "readout": [
