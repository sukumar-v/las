  "specs": {
    "update-talk": {
      "kind": "speech",
      "language": "en",
      "prompt": "Give a one-minute update on your week.",
      "tones": false,
      "pass": "words_per_minute >= 120 && words_per_minute <= 160 && filler_count <= 3",
      "mistakes": [
        {
          "id": "too-fast",
          "when": "words_per_minute > 170",
          "severity": 2,
          "fix_drill": "pace-drill"
        },
        {
          "id": "fillers",
          "when": "filler_count > 5",
          "severity": 2,
          "fix_drill": "pause-swap"
        }
      ]
    },
    "full-talk": {
      "kind": "speech",
      "language": "en",
      "prompt": "Give your five-minute offsite talk.",
      "tones": false,
      "rubric": {
        "kind": "rubric",
        "criteria": [
          {
            "id": "opening",
            "label": "Opening hook",
            "levels": {
              "1": "Starts with thanks or logistics",
              "2": "A plain topic statement",
              "3": "A question, story or striking fact"
            },
            "weight": 1
          },
          {
            "id": "engaging",
            "label": "Engaging",
            "levels": {
              "1": "Flat, read aloud",
              "2": "Some variety in voice",
              "3": "Varied voice, pauses for effect, speaks to the room"
            },
            "weight": 1
          },
          {
            "id": "close",
            "label": "Clear close",
            "levels": {
              "1": "Trails off",
              "2": "Summarizes",
              "3": "One clear takeaway or ask"
            },
            "weight": 1
          }
        ],
        "must_cite": "timestamp",
        "pass": "opening >= 2 && close >= 2",
        "safety_critical": false
      },
      "pass": "filler_count <= 10 && duration_s >= 270",
      "mistakes": []
    },
    "stage-presence": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 30,
        "guide": "Head to knees in frame, as the audience would see you"
      },
      "segment": {
        "by": "whole"
      },
      "metrics": {
        "sway": "std(mid_hip.x)",
        "gesture_share": "share(left_wrist.y < left_hip.y || right_wrist.y < right_hip.y)",
        "face_turns": "std(face_nose_tip.x)"
      },
      "mistakes": [
        {
          "id": "swaying",
          "when": "sway > 0.06",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(mid_hip.x)",
          "fix_drill": "presence-drill"
        }
      ],
      "requires_visible": [
        "left_hip",
        "right_hip",
        "left_wrist",
        "right_wrist"
      ]
    },
    "slide-rubric": {
      "kind": "rubric",
      "criteria": [
        {
          "id": "text_density",
          "label": "Words on the slide",
          "levels": {
            "1": "Paragraphs to read",
            "2": "A few bullet lines",
            "3": "Under ten words"
          },
          "measure": "text(slide)",
          "weight": 2
        },
        {
          "id": "one_idea",
          "label": "One idea",
          "levels": {
            "1": "Several ideas compete",
            "2": "One idea with clutter",
            "3": "One idea, nothing else"
          },
          "weight": 1
        },
        {
          "id": "contrast",
          "label": "Readable from the back",
          "levels": {
            "1": "Low contrast or tiny text",
            "2": "Readable up close",
            "3": "Readable from across a room"
          },
          "measure": "exposure(slide)",
          "weight": 1
        }
      ],
      "must_cite": "region",
      "taps": [
        {
          "id": "main_point",
          "prompt": "Tap the one thing you want people to see"
        }
      ],
      "pass": "text_density >= 2 && one_idea >= 2",
      "safety_critical": false
    },
    "talk-quiz": {
