  "specs": {
    "count-clap": {
      "kind": "audio",
      "reference": {
        "pattern": "xxx.",
        "beats_per_bar": 4,
        "bars": 8
      },
      "tempo": 160,
      "tuning_hz": 440,
      "tolerance": {
        "pitch_cents": 30,
        "onset_ms": 70
      },
      "grade": [
        "onsets",
        "rhythm"
      ],
      "playback": "backing",
      "pass": "onset_share_on_time >= 0.8",
      "mistakes": [
        {
          "id": "clap-early",
          "when": "early_share >= 0.4",
          "severity": 1,
          "show": "beat_timeline",
          "fix_drill": "count-clap-drill"
        }
      ]
    },
    "basic-timing": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 30,
        "guide": "Whole body in frame, facing the camera"
      },
      "segment": {
        "by": "phrases",
        "beats": 8,
        "beat_source": "audio_track"
      },
      "metrics": {
        "timing": "on_beat(left_ankle, right_ankle)",
        "step_offset_ms": "step_offset_ms(left_ankle, right_ankle)",
        "feet_symmetry": "symmetry(left_ankle, right_ankle)",
        "hip_range": "range(mid_hip.x)"
      },
      "units": {
        "step_offset_ms": "ms"
      },
      "mistakes": [
        {
          "id": "rushing",
          "when": "mean(step_offset_ms) < -80",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "beat_timeline",
          "fix_drill": "slow-basic"
        }
      ],
      "requires_visible": [
        "left_ankle",
        "right_ankle",
        "left_hip",
        "right_hip"
      ]
    },
    "turn-check": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 60,
        "guide": "Spins blur at 30 fps: use 60 if your phone can"
      },
      "segment": {
        "by": "moves",
        "beats": 4,
        "beat_source": "audio_track"
      },
      "metrics": {
        "turn_timing": "on_beat(left_ankle, right_ankle) per move",
        "head_bob": "std(nose.y)",
        "stance_width": "mean(distance(left_ankle, right_ankle))"
      },
      "mistakes": [
        {
          "id": "late-turn",
          "when": "mean(turn_timing) < 0.6",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "beat_timeline",
          "fix_drill": "turn-prep"
        }
      ],
      "requires_visible": [
        "nose",
        "left_ankle",
        "right_ankle"
      ]
    },
    "routine-shape": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 60,
        "guide": "Same framing as your reference clip"
      },
      "segment": {
        "by": "phrases",
        "beats": 8,
        "beat_source": "audio_track"
      },
      "reference": "learner-media/salsa-routine-reference.mp4",
      "metrics": {
        "timing": "on_beat(left_ankle, right_ankle)",
        "shape": "pose_similarity(reference, joints: [legs, hips, arms], align: dtw)"
      },
      "mistakes": [
        {
          "id": "off-shape",
          "when": "shape < 0.6",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "ghost",
          "fix_drill": "phrase-ghost"
        }
      ]
