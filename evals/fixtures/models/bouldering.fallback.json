  "specs": {
    "climb-moves": {
      "kind": "metric",
      "capture": {
        "angle": "back",
        "fps": 30,
        "guide": "Behind the climber, whole problem in frame; depth isn't measured from one camera"
      },
      "segment": {
        "by": "moves",
        "min_duration_s": 0.5
      },
      "metrics": {
        "straight_share": "share(angle(left_shoulder, left_elbow, left_wrist) >= 150 && angle(right_shoulder, right_elbow, right_wrist) >= 150)",
        "foot_peak": "max(speed(left_foot_index)) per move",
        "foot_resets": "count(where(foot_peak, foot_peak > 0.5))",
        "hip_jerk": "mean(jerk(mid_hip))",
        "baseline_jerk": "baseline.hip_jerk"
      },
      "mistakes": [
        {
          "id": "bent-arms",
          "when": "straight_share < 0.4",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(angle(left_shoulder, left_elbow, left_wrist))",
          "fix_drill": "straight-arm-traverse"
        },
        {
          "id": "foot-shuffle",
          "when": "foot_resets > 4",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(speed(left_foot_index))",
          "fix_drill": "silent-feet"
        },
        {
          "id": "jerky-hips",
          "when": "hip_jerk > baseline.hip_jerk * 1.3",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "skeleton",
          "fix_drill": "flow-climb"
        }
      ],
      "requires_visible": [
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_hip",
        "right_hip"
      ]
    },
