  "specs": {
    "stroke-rubric": {
      "kind": "rubric",
      "criteria": [
        {
          "id": "pen_angle",
          "label": "Pen angle",
          "levels": {
            "1": "Angle drifts by more than 15 degrees",
            "2": "Mostly steady",
            "3": "Steady within 5 degrees"
          },
          "measure": "angle(stroke_start, stroke_end)",
          "weight": 2
        },
        {
          "id": "contrast",
          "label": "Thick-thin contrast",
          "levels": {
            "1": "Strokes all one width",
            "2": "Clear thick and thin",
            "3": "Crisp hairlines and full thicks"
          },
          "measure": "edge_density(strokes)",
          "weight": 1
        }
      ],
      "must_cite": "region",
      "taps": [
        {
          "id": "stroke_start",
          "prompt": "Tap where a thin stroke starts"
        },
        {
          "id": "stroke_end",
          "prompt": "Tap where it ends"
        }
      ],
      "pass": "pen_angle >= 2 && contrast >= 2",
      "safety_critical": false
    },
    "letter-rubric": {
      "kind": "rubric",
      "criteria": [
        {
          "id": "shape",
          "label": "Letter shapes",
          "levels": {
            "1": "Round arches, unlike italic",
            "2": "Mostly italic shapes",
            "3": "Consistent italic shapes"
          },
          "weight": 1
        },
        {
          "id": "slant",
          "label": "Slant",
          "levels": {
            "1": "Slant wanders",
            "2": "Mostly even",
            "3": "Even, about 7 degrees"
          },
          "measure": "angle(slant_top, slant_bottom)",
          "weight": 1
        },
        {
          "id": "x_height",
          "label": "x-height",
          "levels": {
            "1": "Heights vary by over 20%",
            "2": "Within 10%",
            "3": "Within 5%"
          },
          "measure": "tapped_points(baseline, x_line)",
          "level_from": "if(height_spread < 0.05, 3, if(height_spread < 0.1, 2, 1))",
          "weight": 1
        }
      ],
      "must_cite": "region",
      "taps": [
        {
          "id": "baseline",
          "prompt": "Tap the baseline"
        },
        {
          "id": "x_line",
          "prompt": "Tap the top of an n"
        },
        {
          "id": "slant_top",
          "prompt": "Tap the top of a stem"
        },
        {
          "id": "slant_bottom",
          "prompt": "Tap its bottom"
        }
      ],
      "pass": "shape >= 2 && slant >= 2 && x_height >= 2",
      "safety_critical": false
    },
    "spacing-rubric": {
      "kind": "rubric",
      "criteria": [
        {
          "id": "spacing",
          "label": "Spacing",
          "levels": {
            "1": "Letters bunch and gap",
            "2": "Mostly even",
            "3": "Even texture across lines"
          },
          "measure": "proportion(gaps)",
          "weight": 1
        }
      ],
      "must_cite": "region",
      "pass": "spacing >= 2",
      "safety_critical": false
    },
