  "specs": {
    "swing-body": {
      "kind": "metric",
      "capture": {
        "angle": "front",
        "fps": 60,
        "guide": "Face-on, whole body and ball in frame; 60 fps or more, the club blurs"
      },
      "segment": {
        "by": "moves",
        "min_duration_s": 0.8
      },
      "phases": {
        "top": "left_wrist.y == min(left_wrist.y)",
        "address": "t < 0.5"
      },
      "metrics": {
        "address_tilt": "mean(angle(mid_shoulder, mid_hip, vertical)) at address",
        "head_sway": "range(nose.x) per move",
        "backswing_s": "phase_duration(up) per move",
        "downswing_s": "phase_duration(down) per move",
        "tempo_ratio_video": "mean(backswing_s) / mean(downswing_s)",
        "hands_ahead": "left_wrist.x < object.sports_ball.x",
        "ball_seen": "visible(object.sports_ball)",
        "swings": "count(head_sway)",
        "tempo_ratio": "tempo_ratio_video"
      },
      "units": {
        "address_tilt": "deg",
        "backswing_s": "s",
        "downswing_s": "s"
      },
      "mistakes": [
        {
          "id": "head-sway",
          "when": "mean(head_sway) > 0.08",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(nose.x)",
          "fix_drill": "half-swings"
        },
        {
          "id": "scooping",
          "when": "share(hands_ahead) < 0.5",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "overlay(left_wrist.x - object.sports_ball.x)",
          "fix_drill": "impact-swings"
        },
        {
          "id": "rushed-tempo",
          "when": "tempo_ratio_video < 2",
          "min_confidence": 0.7,
          "severity": 2,
          "show": "skeleton",
          "fix_drill": "tempo-swings"
        }
      ],
      "requires_visible": [
        "nose",
        "left_wrist",
        "left_shoulder",
        "left_hip"
      ]
    },
    "swing-tempo": {
      "kind": "sensor",
      "detect": "swing-tempo",
      "placement": "strapped",
      "duration_s": 180,
      "target": {
        "tempo_ratio": 3
      },
      "pass": "tempo_ratio >= 2.5 && tempo_ratio <= 3.5"
    },
    "golf-quiz": {
      "kind": "items",
      "items": [
        {
          "type": "choice",
          "id": "g1",
          "prompt": "In a neutral grip, how many knuckles of the lead hand do you see?",
          "options": [
            "Two or three",
            "None",
            "All four"
          ],
          "answer": 0,
          "difficulty": 1,
          "nodes": [
            "setup"
          ]
