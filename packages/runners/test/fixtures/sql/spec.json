{
  "language": "sql",
  "entry": "schema.sql",
  "tests": [
    {
      "call": "SELECT count(*) FROM people;",
      "expect": "3"
    },
    {
      "call": "SELECT name FROM adults_over_30;",
      "expect": "Ada\nBea"
    },
    {
      "call": "SELECT sum(age) FROM people WHERE age < 30;",
      "expect": "29",
      "hidden": true
    },
    {
      "call": "SELECT min(age) FROM people;",
      "expect": "30",
      "label": "deliberate failure"
    },
    {
      "call": "SELECT * FROM missing_table;",
      "expect": "0",
      "label": "raises an error"
    },
    {
      "stdin": "SELECT name FROM people ORDER BY age LIMIT 1;\n",
      "stdout": "Cyd"
    }
  ],
  "runner": [
    "local"
  ],
  "limits": {
    "time_s": 10
  },
  "spin": "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c) SELECT count(*) FROM c;"
}
