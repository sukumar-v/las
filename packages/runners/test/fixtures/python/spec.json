{
  "language": "python",
  "entry": "solution.py",
  "tests": [
    {
      "call": "add(2, 3)",
      "expect": "5"
    },
    {
      "call": "count_words(\"hello big world\")",
      "expect": "3"
    },
    {
      "call": "count_words(\"\")",
      "expect": "0",
      "hidden": true
    },
    {
      "call": "add(2, 2)",
      "expect": "5",
      "label": "deliberate failure"
    },
    {
      "call": "divide(1, 0)",
      "expect": "0",
      "label": "raises an error"
    },
    {
      "stdin": "Ada\n",
      "stdout": "Hello, Ada!"
    }
  ],
  "runner": [
    "local"
  ],
  "limits": {
    "time_s": 10
  },
  "spin": "spin()"
}
